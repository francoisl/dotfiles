{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.claude/git-conventions.md",
    "~/.claude/output-styles/simple-english.md",
    "~/.config/opencode/gh-api-read.md",
    "~/.config/opencode/github-comment-preferences.md"
  ],
  "permission": {
    "external_directory": {
      "~/.claude/**": "allow",
      "/opt/homebrew/bin/**": "allow",
      "~/Expensidev": "allow",
      "~/Expensidev/**": "allow",
      "~": "allow",
      "~/**": "allow"
    },
    "read": {
      "/opt/homebrew/bin/**": "allow",
      "~/Expensidev": "allow",
      "~/Expensidev/**": "allow",
      "~": "allow",
      "~/**": "allow"
    },
    "edit": {
      "~/.claude/**": "ask"
    },
    "bash": {
      "*": "ask",
      "rg *": "allow",
      "rtk rg *": "allow",
      "fd *": "allow",
      "ls *": "allow",
      "rtk ls": "allow",
      "rtk ls *": "allow",
      "jq *": "allow",
      "rtk jq *": "allow",
      "which *": "allow",
      "rtk which *": "allow",
      "date*": "allow",
      "stat *": "allow",
      "rtk stat *": "allow",
      "git status*": "allow",
      "rtk git status*": "allow",
      "git diff*": "allow",
      "rtk git diff*": "allow",
      "git log*": "allow",
      "rtk git log*": "allow",
      "git show*": "allow",
      "rtk git show*": "allow",
      "git fetch*": "allow",
      "rtk git fetch*": "allow",
      "gh issue list*": "allow",
      "rtk gh issue list*": "allow",
      "gh issue view*": "allow",
      "rtk gh issue view*": "allow",
      "gh pr list*": "allow",
      "rtk gh pr list*": "allow",
      "gh pr view*": "allow",
      "rtk gh pr view*": "allow",
      "gh pr diff*": "allow",
      "rtk gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "rtk gh pr checks*": "allow",
      "gh search*": "allow",
      "git commit*": "ask",
      "git checkout*": "ask",
      "git push*": "ask",
      "gh api*": "ask",
      "rtk gh api*": "ask",
      "gh-api-get *": "allow",
      "git blame*": "allow",
      "rtk git blame*": "allow",
      "git worktree*": "allow",
      "rtk git worktree*": "allow",
      "gh run view*": "allow",
      "rtk gh run view*": "allow",
      "git rev-parse*": "allow",
      "rtk git rev-parse*": "allow",
      "which*": "allow",
      "opencode --help": "allow",
      "./scripts/style.sh*": "allow",
      "vssh*": "allow",
      "type": "allow",
      "type *": "allow",
      "command -v*": "allow",
      "git remote *": "allow",
      "crit *": "allow"
    },
    "webfetch": "allow",
    // Slack MCP (via Cerebro): block write tools. Read tools stay allowed.
    // Patterns match tool names such as cerebro_slack_send_message.
    "cerebro_slack_*send*": "deny",
    "cerebro_slack_*post*": "deny",
    "cerebro_slack_*reply*": "deny",
    "cerebro_slack_*schedule_*": "deny",
    "cerebro_slack_*scheduleMessage*": "deny",
    "cerebro_slack_*create*": "deny",
    "cerebro_slack_*update*": "deny",
    "cerebro_slack_*edit*": "deny",
    "cerebro_slack_*delete*": "deny",
    "cerebro_slack_*upload*": "deny",
    "cerebro_slack_*add*": "deny",
    "cerebro_slack_*remove*": "deny",
    "cerebro_slack_*invite*": "deny",
    "cerebro_slack_*kick*": "deny",
    "cerebro_slack_*join*": "deny",
    "cerebro_slack_*leave*": "deny",
    "cerebro_slack_*archive*": "deny",
    "cerebro_slack_*rename*": "deny",
    "cerebro_slack_*_set*": "deny"
  },
  "plugin": ["./plugins/crit.ts"],
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp" : {
    "cerebro": {
      "type": "remote",
      "url": "https://mcp.cerebro.exfy.io/mcp",
      "oauth": {}
    }
  }
}
