{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.claude/git-conventions.md",
    "~/.claude/output-styles/simple-english.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "rg *": "allow",
      "rtk rg *": "allow",
      "fd *": "allow",
      "ls *": "allow",
      "rtk ls": "allow",
      "rtk ls *": "allow",
      "jq *": "allow",
      "rtk jq *": "allow",
      "date*": "allow",
      "stat *": "allow",
      "rtk stat *": "allow",
      "git status*": "allow",
      "rtk git status*": "allow",
      "git diff*": "allow",
      "rtk git diff*": "allow",
      "git log*": "allow",
      "rtk git log*": "allow",
      "git show*": "allow",
      "rtk git show*": "allow",
      "git fetch*": "allow",
      "rtk git fetch*": "allow",
      "gh issue list*": "allow",
      "rtk gh issue list*": "allow",
      "gh issue view*": "allow",
      "rtk gh issue view*": "allow",
      "gh pr list*": "allow",
      "rtk gh pr list*": "allow",
      "gh pr view*": "allow",
      "rtk gh pr view*": "allow",
      "gh pr diff*": "allow",
      "rtk gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "rtk gh pr checks*": "allow",
      "gh search*": "allow",
      "git commit*": "ask",
      "git checkout*": "ask",
      "git push*": "ask",
      "gh api*": "ask"
    },
    "webfetch": "ask"
  },
  "plugin": ["./plugins/crit.ts"]
}
